# Kernel fragment for SIMCOM SIM7600E (RNDIS + option AT serial).
# Applied on top of infinity6e-ssc012b.config via
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES.
#
# Drivers needed match what /etc/wireless/modem does on the reference camera:
#   modprobe rndis_host         -> needs RNDIS_HOST + USBNET + CDC_ETHER
#   modprobe option             -> needs USB_SERIAL + USB_SERIAL_OPTION + USB_SERIAL_WWAN
#   echo "1e0e 9011" > /sys/bus/usb-serial/drivers/option1/new_id

# Top-level groups
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y

# USB networking (RNDIS modem mode)
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m

# USB serial (AT commands, ttyUSBx)
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
